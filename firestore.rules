rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasUserDoc() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isUser() {
        return hasUserDoc()
        && getUserData().userRole == 'user'
        && getUserData().userStatus == 'active';
    }

    function isAdmin() {
      return hasUserDoc()
        && getUserData().userRole == 'admin'
        && getUserData().userStatus == 'active';
    }

    function isSupportOwner(requestId) {
      return (isUser() || isAdmin())
        && get(/databases/$(database)/documents/supportRequests/$(requestId)).data.userId == request.auth.uid;
    }


    // ── Global admin override ───────────────────────────────────────────────
    match /{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── users ───────────────────────────────────────────────────────────────
    match /users/{uid} {
      // Any approved member may read the roster/directory; a not-yet-approved
      // owner may still read their own document to drive onboarding.
      allow read: if isUser() || isOwner(uid);

      allow create, update: if false;

      // No client deletes of user documents (admins covered by the global rule).

      // Owner-private schedule template. Writable while still pending so the
      // onboarding flow can seed default availability before approval.
      match /schedule/{document=**} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // ── availability (coach discovery cache) ────────────────────────────────
    // Readable by any approved member for discovery. Never written directly by
    // clients — it is maintained solely by the backend Cloud Functions (Admin
    // SDK, which bypasses these rules) and by admins via the global rule.
    match /availability/{coachUid} {
      allow read: if isUser();
      allow write: if false;
    }

    // ── bookings ────────────────────────────────────────────────────────────
    // Created, cancelled, and status-changed EXCLUSIVELY through the
    // manageBooking Cloud Function (Admin SDK). Participants may read only their
    // own bookings, and may self-heal the Google Meet link — nothing else.
    match /bookings/{bookingId} {
      allow read: if isUser()
        && (request.auth.uid == resource.data.coachUid
            || request.auth.uid == resource.data.clientUid);

      allow write: if false;
    }

    // ── systemLogs (telemetry sink) ─────────────────────────────────────────
    // Append-only for approved members. Each entry must be self-stamped
    // (userId == caller). Reads are admin-only (global rule).
    match /systemLogs/{logId} {
      allow create: if isUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type in ['error', 'warn']
        && request.resource.data.keys().hasOnly([
             'type', 'event', 'userId', 'userEmail', 'errorMessage', 'timestamp', 'expireAt'
           ]);
    }

    // ── supportRequests (+ messages) ────────────────────────────────────────
    // A member may see and manage ONLY their own tickets; admins get every
    // ticket via the global rule. Deletes are admin-only.
    match /supportRequests/{requestId} {
      allow read:   if (isUser() || isAdmin()) && resource.data.userId == request.auth.uid;
      allow create: if (isUser() || isAdmin()) && request.resource.data.userId == request.auth.uid;
      allow update: if (isUser() && resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if (isUser() || isAdmin()) && isSupportOwner(requestId);
        allow create: if (isUser() || isAdmin())
          && isSupportOwner(requestId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderRole == (isAdmin() ? 'admin' : 'user');
      }
    }
  }
}
