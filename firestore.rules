rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // An admin is an active user whose role is 'admin'. NOTE: this is a
    // document-based check. Promoting admin to a Firebase Auth custom claim
    // (set only by a trusted backend) would add defense-in-depth and remove the
    // per-check get(); that requires a server component this client-only app
    // does not yet have.
    //
    // The exists() guard is required because this function is also evaluated by
    // the global admin rule below on EVERY request — including a user's own
    // sign-up create, when their profile does not exist yet. Without the guard,
    // currentUserDoc() would dereference a null get() and error. get()/exists()
    // to the same path are cached per request, so the guard adds no extra
    // document-access cost.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && currentUserDoc().userRole == 'admin'
        && currentUserDoc().userStatus == 'active';
    }

    // ── Global admin access ─────────────────────────────────────────────────
    // Admins default to FULL read/write access to every collection. Firestore
    // grants a request if ANY matching rule allows it, so this wildcard is
    // layered on top of the per-collection rules below: those rules govern
    // regular users, and this one gives admins blanket access — including to
    // any collection added later — without having to thread isAdmin() through
    // each rule. Non-admin permissions are unaffected (rules only ever add
    // access, never remove it).
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Global Type Safety & Limits Helpers
    function isString(val) {
      return val is string;
    }

    function isInt(val) {
      return val is int;
    }

    function isBool(val) {
      return val is bool;
    }

    function isTimestamp(val) {
      return val is timestamp;
    }

    function isMap(val) {
      return val is map;
    }

    function isList(val) {
      return val is list;
    }

    function isValidString(val, maxLen) {
      return isString(val) && val.size() <= maxLen;
    }

    // Validation helper for user profile documents
    function isValidUserDoc(data) {
      return isMap(data)
        && isValidString(data.userId, 100)
        && isValidString(data.email, 150)
        && isValidString(data.firstName, 100)
        && isValidString(data.lastName, 100)
        && (data.get('displayName', null) == null || isValidString(data.displayName, 200))
        && (data.get('photoURL', null) == null || isValidString(data.photoURL, 1000))
        && isString(data.gender)
        && isValidString(data.country, 100)
        && (data.get('icf_acc', null) == null || isBool(data.icf_acc))
        && (data.get('icf_pcc', null) == null || isBool(data.icf_pcc))
        && (data.get('icf_mcc', null) == null || isBool(data.icf_mcc))
        && (data.get('icf_actc', null) == null || isBool(data.icf_actc))
        && isValidString(data.bio, 2000)
        && isValidString(data.timezone, 100)
        && (data.userRole == 'user' || data.userRole == 'admin')
        && (data.userStatus == 'active' || data.userStatus == 'inactive')
        && (data.theme == 'light' || data.theme == 'dark')
        && isTimestamp(data.createdAt);
    }

    // Validation helper for schedule days subcollection
    function isValidDayAvailability(dayData) {
      return isMap(dayData)
        && isBool(dayData.enabled)
        && isList(dayData.slots);
    }

    function isValidScheduleDays(data) {
      return isMap(data)
        && isValidDayAvailability(data.monday)
        && isValidDayAvailability(data.tuesday)
        && isValidDayAvailability(data.wednesday)
        && isValidDayAvailability(data.thursday)
        && isValidDayAvailability(data.friday)
        && isValidDayAvailability(data.saturday)
        && isValidDayAvailability(data.sunday);
    }

    // Validation helper for schedule blocked dates
    function isValidBlockedDates(data) {
      return isMap(data)
        && isList(data.blockedDates)
        && data.blockedDates.size() <= 100;
    }

    // Validation helper for booking documents
    function isValidBookingDoc(data) {
      return isMap(data)
        && isValidString(data.bookingId, 150)
        && isString(data.googleEventId)
        && isString(data.googleMeetLink)
        && (data.googleMeetLink == '' || data.googleMeetLink.matches('https://meet\\.google\\.com/.*'))
        && (data.status == 'pending' || data.status == 'confirmed' || data.status == 'cancelled')
        && isTimestamp(data.startTime)
        && isTimestamp(data.endTime)
        && isValidString(data.topic, 1000)
        && isValidString(data.coachUid, 100)
        && isValidString(data.clientUid, 100)
        && isTimestamp(data.createdAt)
        // startIso is optional here (legacy bookings predate it) but, when
        // present, must be a bounded ISO-8601 UTC instant. The create rule below
        // requires it and pins it to both the bookingId and the coach's published
        // availability shard; keeping it optional here keeps updates and
        // cancellations of older bookings valid.
        && (data.get('startIso', null) == null
            || (isValidString(data.startIso, 100)
                && data.startIso.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z')))
        && (data.get('cancelledAt', null) == null || isTimestamp(data.cancelledAt))
        && (data.get('expireAt', null) == null || isTimestamp(data.expireAt));
    }

    // PCN-038: a booking may only be created for a slot the named coach has
    // actually published. The coach's per-day availability shard
    // (coachAvailabilityByDate/{coachUid}_{dateISO}) is written ONLY by that
    // coach and lists their free slots as full ISO instants, so requiring the
    // booked startIso to be a member proves the coach genuinely offered it. This
    // is one extra get() on the bookings-create path only. dateISO is derived
    // from startIso via split('T') (a UTC instant's calendar date is its prefix
    // before 'T'), avoiding a separate spoofable field.
    //
    // CALLER CONTRACT: only call this AFTER the create rule's
    // `bookingId == coachUid + '_' + startIso` guard. That equality forces
    // startIso to be a present, slash-free string (document IDs cannot contain
    // '/'), which is what keeps the interpolated shard path from being coerced
    // into unintended path segments. Do not reorder this ahead of that check.
    function coachPublishedSlot(coachUid, startIso) {
      let dateISO = startIso.split('T')[0];
      let shardPath = /databases/$(database)/documents/coachAvailabilityByDate/$(coachUid + '_' + dateISO);
      return exists(shardPath)
        && startIso in get(shardPath).data.freeSlots;
    }

    // Validation helper for client booking cache
    function isValidClientBookingCacheDoc(data) {
      return isMap(data)
        && isValidString(data.clientUid, 100)
        && isValidString(data.coachUid, 100)
        && isValidString(data.bookingId, 150)
        && isValidString(data.startIso, 100)
        && isTimestamp(data.createdAt)
        && isTimestamp(data.expireAt);
    }

    // Validation helper for the coach's aggregate availability cache.
    // Upper bound: BOOKING_HORIZON_DAYS (30) x 24 hourly slots = 720 possible
    // slots, plus margin. The previous cap of 200 rejected any coach whose
    // template exceeded ~25 hours/week over the horizon (e.g. all 7 days, 9-5).
    function isValidPersonalAvailabilityCache(data) {
      return isMap(data)
        && isValidString(data.userId, 100)
        && isValidString(data.lastUpdated, 100)
        && isList(data.availableSlots)
        && data.availableSlots.size() <= 750
        && (data.get('gender', null) == null || isString(data.gender))
        && (data.get('country', null) == null || isValidString(data.country, 100))
        && (data.get('icf_acc', null) == null || isBool(data.icf_acc))
        && (data.get('icf_pcc', null) == null || isBool(data.icf_pcc))
        && (data.get('icf_mcc', null) == null || isBool(data.icf_mcc))
        && (data.get('icf_actc', null) == null || isBool(data.icf_actc))
        && (data.get('availableDatesUtc', null) == null || isList(data.availableDatesUtc));
    }

    // Validation helper for per-coach, per-day availability shards.
    function isValidCoachAvailabilityByDate(data) {
      return isMap(data)
        && isValidString(data.coachUid, 100)
        && isValidString(data.dateISO, 10)
        // dateISO must be a real YYYY-MM-DD calendar date, not arbitrary text.
        // (Firestore rules cannot iterate `freeSlots` to type/length-check each
        // element; the client generator bounds those and the count is capped at
        // 24 below. Element-level validation would require a backend.)
        && data.dateISO.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && isList(data.freeSlots)
        && data.freeSlots.size() <= 24
        && isValidString(data.lastUpdated, 100)
        && (data.get('gender', null) == null || isString(data.gender))
        && (data.get('country', null) == null || isValidString(data.country, 100))
        && (data.get('icf_acc', null) == null || isBool(data.icf_acc))
        && (data.get('icf_pcc', null) == null || isBool(data.icf_pcc))
        && (data.get('icf_mcc', null) == null || isBool(data.icf_mcc))
        && (data.get('icf_actc', null) == null || isBool(data.icf_actc));
    }

    // Validation helper for support message structure
    function isValidSupportMessage(msg) {
      return isMap(msg)
        && isValidString(msg.id, 100)
        && isValidString(msg.senderId, 100)
        && isValidString(msg.senderName, 200)
        && (msg.senderRole == 'user' || msg.senderRole == 'admin')
        && isValidString(msg.content, 2000) // Hard size limit enforced
        && isTimestamp(msg.createdAt);
    }

    // Validation helper for support request documents
    function isValidSupportRequestDoc(data) {
      return isMap(data)
        && isValidString(data.id, 100)
        && isValidString(data.userId, 100)
        && isValidString(data.userDisplayName, 200)
        && isValidString(data.userEmail, 150)
        && (data.category == 'Report Bugs' || data.category == 'Feature Request' || data.category == 'General Inquiry')
        && isValidString(data.subject, 200)
        && (data.status == 'open' || data.status == 'closed')
        && isTimestamp(data.createdAt)
        && isTimestamp(data.updatedAt);
    }

    // An optional map field: absent, or a string no longer than maxLen.
    // Uses .get() so the key can be passed dynamically.
    function isOptBoundedString(m, key, maxLen) {
      return m.get(key, '') is string && m.get(key, '').size() <= maxLen;
    }

    // Validation helper for the systemLogs `details` map. Because this is a
    // client-only app (no Cloud Functions to sink/rate-limit logs), the client
    // SDK is the only enforcement point: without these bounds any signed-in user
    // could write arbitrarily large log documents with arbitrary keys, driving
    // storage cost. We therefore (1) cap the key count, (2) restrict keys to a
    // known safe allowlist (the fields actually emitted by logger.telemetry),
    // and (3) cap each value's size.
    function isValidSystemLogDetails(details) {
      return isMap(details)
        && details.size() <= 10
        && details.keys().hasOnly([
          'errorCode', 'errorMessage', 'error',
          'userId', 'clientUid', 'coachUid', 'startIso',
          'bookingId', 'clientBookingCacheId', 'uids'
        ])
        && isOptBoundedString(details, 'errorCode', 200)
        && isOptBoundedString(details, 'errorMessage', 500)
        && isOptBoundedString(details, 'error', 500)
        && isOptBoundedString(details, 'userId', 100)
        && isOptBoundedString(details, 'clientUid', 100)
        && isOptBoundedString(details, 'coachUid', 100)
        && isOptBoundedString(details, 'startIso', 100)
        && isOptBoundedString(details, 'bookingId', 150)
        && isOptBoundedString(details, 'clientBookingCacheId', 250)
        && (details.get('uids', null) == null
            || (details.uids is list && details.uids.size() <= 50));
    }

    // Validation helper for public anonymized busy slots
    function isValidBusySlotDoc(data) {
      return isMap(data)
        && isTimestamp(data.startTime)
        && isTimestamp(data.endTime)
        && isValidString(data.coachUid, 100);
    }

    // Privileged fields may only be set by an admin. An owner editing their own
    // profile must leave these unchanged.
    function privilegedFieldsUnchanged() {
      return request.resource.data.userRole == resource.data.userRole
        && request.resource.data.userStatus == resource.data.userStatus
        && request.resource.data.get('icf_acc', null) == resource.data.get('icf_acc', null)
        && request.resource.data.get('icf_pcc', null) == resource.data.get('icf_pcc', null)
        && request.resource.data.get('icf_mcc', null) == resource.data.get('icf_mcc', null)
        && request.resource.data.get('icf_actc', null) == resource.data.get('icf_actc', null);
    }

    // Identity fields are immutable on a self-update (defense-in-depth).
    function selfUpdateAllowed() {
      return privilegedFieldsUnchanged()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /users/{uid} {
      // Any signed-in user can read profiles (needed to browse peer coaches).
      allow read: if isSignedIn();

      // Self sign-up: a user may create only their own document, only as a
      // pending account (inactive), and only with the 'user' role. (Admins get
      // full access via the global admin rule at the top of this file.)
      allow create: if isOwner(uid)
        && request.resource.data.userStatus == 'inactive'
        && request.resource.data.userRole == 'user'
        && isValidUserDoc(request.resource.data);

      // Owners may edit their own non-privileged fields; admins may edit anything.
      allow update: if isAdmin()
        || (isOwner(uid) && selfUpdateAllowed() && isValidUserDoc(request.resource.data));

      allow delete: if isAdmin();

      match /schedule/availableDays {
        allow read: if isSignedIn();
        allow write: if (isOwner(uid) && isValidScheduleDays(request.resource.data)) || (isAdmin() && isValidScheduleDays(request.resource.data));
      }

      match /schedule/blockedDates {
        allow read: if isSignedIn();
        allow write: if (isOwner(uid) && isValidBlockedDates(request.resource.data)) || (isAdmin() && isValidBlockedDates(request.resource.data));
      }
    }

    match /bookings/{bookingId} {
      allow read: if isSignedIn()
        && (isAdmin()
          || (resource != null && request.auth.uid in [
            resource.data.coachUid,
            resource.data.clientUid
          ]));

      // Only a participant may create a booking they are part of, and the
      // booking ID must match the coachUid format to prevent slot hijacking.
      // Enforced initial status must be pending. (Admins get full access via the
      // global admin rule at the top of this file.)
      //
      // PCN-038 MITIGATION: the initiator could previously name an arbitrary
      // counterparty (a victim coach, or a victim client) at ANY slot —
      // fabricating or squatting sessions in a victim's name. We now require the
      // booked slot to be one the named coach has actually PUBLISHED in their own
      // coachAvailabilityByDate shard (an independently-existing doc only that
      // coach can write), so a booking can no longer be manufactured against a
      // coach for a slot they never offered. See coachPublishedSlot().
      //
      // RESIDUAL RISK: naming an arbitrary *client* as the victim while booking a
      // real, coach-offered slot is still not fully closable in rules alone — the
      // client's consent lock (clientBookingCache) is written in the SAME
      // transaction, so it is not visible to this create-time get(). The durable
      // fix is an authoritative backend (PCN-035) or an in-app visibility/decline
      // control; tracked separately, not addressed here.
      allow create: if isSignedIn()
        && currentUserDoc().userStatus == 'active'
        && request.auth.uid in [
          request.resource.data.coachUid,
          request.resource.data.clientUid
        ]
        // Pin bookingId and the published-slot check to startIso so the named
        // slot cannot be spoofed. This tightens the previous prefix-only match.
        && bookingId == request.resource.data.coachUid + '_' + request.resource.data.startIso
        && coachPublishedSlot(request.resource.data.coachUid, request.resource.data.startIso)
        && request.resource.data.status == 'pending'
        && isValidBookingDoc(request.resource.data);

      // Participants (or admins) may modify/cancel a booking.
      // coachUid, clientUid, startTime, endTime, and startIso are immutable on
      // update. The startIso comparison uses .get() so it tolerates legacy
      // bookings that predate the field (absent == absent).
      allow update: if isSignedIn()
        && (isAdmin()
          || (
            request.auth.uid in [
              resource.data.coachUid,
              resource.data.clientUid
            ]
            && request.resource.data.coachUid == resource.data.coachUid
            && request.resource.data.clientUid == resource.data.clientUid
            && request.resource.data.startTime == resource.data.startTime
            && request.resource.data.endTime == resource.data.endTime
            && request.resource.data.get('startIso', null) == resource.data.get('startIso', null)
            && isValidBookingDoc(request.resource.data)
          ));

      allow delete: if isSignedIn()
        && (isAdmin()
          || request.auth.uid in [
            resource.data.coachUid,
            resource.data.clientUid
          ]);
    }

    match /busySlots/{bookingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && bookingId.matches(request.resource.data.coachUid + '_.*')
        && isValidBusySlotDoc(request.resource.data);
      allow update: if isSignedIn()
        && (isAdmin()
          || request.auth.uid == resource.data.coachUid
          || (exists(/databases/$(database)/documents/bookings/$(bookingId))
              && get(/databases/$(database)/documents/bookings/$(bookingId)).data.clientUid == request.auth.uid))
        && request.resource.data.coachUid == resource.data.coachUid
        && request.resource.data.startTime == resource.data.startTime
        && request.resource.data.endTime == resource.data.endTime
        && isValidBusySlotDoc(request.resource.data);
      allow delete: if isSignedIn()
        && (isAdmin()
          || request.auth.uid == resource.data.coachUid
          || (exists(/databases/$(database)/documents/bookings/$(bookingId))
              && get(/databases/$(database)/documents/bookings/$(bookingId)).data.clientUid == request.auth.uid));
    }

    // Per-mentee/per-slot locks that prevent a mentee double-booking themselves
    // across coaches in the same time slot.
    match /clientBookingCache/{cacheId} {
      // Content (clientUid/coachUid/startIso — who books whom and when) is only
      // readable by a participant or an admin, so booking relationships no longer
      // leak to every signed-in user. `resource == null` is intentionally allowed:
      // the booking transaction probes deterministically-named lock docs
      // ("{uid}_{iso}") that usually do not exist, and a get() on a missing doc is
      // still subject to this read rule — denying null would break every booking's
      // no-conflict fast path. Probing only reveals existence, never content.
      //
      // EDGE: the reserve transaction also cross-reads a coach's *existing*
      // coach-as-client lock ("{coachUid}_{iso}") where the initiator is not a
      // participant. That read is now denied, so a booking against a coach who is
      // concurrently a mentee at the same slot fails via permission-denied
      // (retried, then a generic error) rather than a clean SLOT_TAKEN. This still
      // fails SAFE — the booking is rejected, never double-booked — and that slot
      // is meant to be unbookable anyway. A cleaner signal would mirror the
      // coach-as-client conflict into a participant-agnostic public collection.
      allow read: if isSignedIn()
        && (isAdmin()
          || resource == null
          || resource.data.clientUid == request.auth.uid
          || resource.data.coachUid == request.auth.uid);
      allow create: if isSignedIn()
        && currentUserDoc().userStatus == 'active'
        && request.resource.data.clientUid == request.auth.uid
        && cacheId.matches(request.resource.data.clientUid + '_.*')
        && isValidClientBookingCacheDoc(request.resource.data);
      allow update: if isSignedIn()
        && (isAdmin()
          || (resource.data.clientUid == request.auth.uid
              && request.resource.data.clientUid == resource.data.clientUid
              && request.resource.data.coachUid == resource.data.coachUid
              && request.resource.data.bookingId == resource.data.bookingId
              && request.resource.data.startIso == resource.data.startIso
              && isValidClientBookingCacheDoc(request.resource.data)));
      allow delete: if isSignedIn()
        && (isAdmin()
          || resource.data.clientUid == request.auth.uid
          || resource.data.coachUid == request.auth.uid);
    }

    match /personalAvailabilityCache/{uid} {
      // Derived aggregate cache backing the coach's own availability view.
      // Readable by any signed-in user. Writable only by the OWNER, or by an
      // admin (admin profile/credential edits trigger a recalc for that coach).
      // This is a single-document write, so isAdmin()'s get() calls stay well
      // within the 10-document-access budget.
      allow read: if isSignedIn();
      allow write: if (isOwner(uid) || isAdmin()) && isValidPersonalAvailabilityCache(request.resource.data) && request.resource.data.userId == uid;
    }

    match /coachAvailabilityByDate/{docId} {
      // Per-coach, per-day availability shards for O(day)-scoped discovery.
      // Readable by any signed-in user. The owning coach writes their own shards:
      // the document ID must be "{ownUid}_{dateISO}" and coachUid must match.
      //
      // These per-collection rules are intentionally free of get()/exists()
      // calls. Shards are rebuilt in a writeBatch of up to ~30 documents, and
      // Firestore allows only 20 document-access calls per batched write, so the
      // coach's own write path must stay cheap. Admin access is provided by the
      // global admin rule at the top of this file; because its single isAdmin()
      // get()/exists() is against the requester's own /users doc and cached per
      // request, it costs one document access across the whole batch — safely
      // within budget.
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && isValidCoachAvailabilityByDate(request.resource.data)
        && request.resource.data.coachUid == request.auth.uid
        && docId == request.auth.uid + '_' + request.resource.data.dateISO;
      allow delete: if isSignedIn() && resource.data.coachUid == request.auth.uid;
    }

    match /systemLogs/{logId} {
      // Any signed-in user can submit logs, but only admins can read or manage them.
      allow create: if isSignedIn()
        && (request.resource.data.type == 'info' || request.resource.data.type == 'warn' || request.resource.data.type == 'error')
        && isValidString(request.resource.data.event, 200)
        && (request.resource.data.get('userId', null) == null || request.resource.data.userId == request.auth.uid)
        && isValidSystemLogDetails(request.resource.data.details)
        && isTimestamp(request.resource.data.timestamp)
        && isTimestamp(request.resource.data.expireAt);
      allow read, update, delete: if isAdmin();
    }

    match /supportRequests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'open'
        && isValidSupportRequestDoc(request.resource.data);
      
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow update: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid
            && request.resource.data.userId == resource.data.userId
            && request.resource.data.id == resource.data.id
            && request.resource.data.userDisplayName == resource.data.userDisplayName
            && request.resource.data.userEmail == resource.data.userEmail
            && request.resource.data.category == resource.data.category
            && request.resource.data.subject == resource.data.subject
            && request.resource.data.createdAt == resource.data.createdAt
            && (request.resource.data.status == 'open' || request.resource.data.status == 'closed')
            && isValidSupportRequestDoc(request.resource.data));

      allow delete: if isAdmin();

      match /messages/{messageId} {
        // Read: Admins, or the owner of the parent support ticket
        allow read: if isAdmin()
          || (isSignedIn() && get(/databases/$(database)/documents/supportRequests/$(requestId)).data.userId == request.auth.uid);

        // Create: The creator must sign their own message (senderId validation), and must be either an Admin or the ticket owner
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && (isAdmin() || get(/databases/$(database)/documents/supportRequests/$(requestId)).data.userId == request.auth.uid)
          && isValidSupportMessage(request.resource.data);

        // Update: Messages are immutable
        allow update: if false;

        // Delete: Cascaded when deleting the parent support request (Admin only)
        allow delete: if isAdmin();
      }
    }
  }
}
