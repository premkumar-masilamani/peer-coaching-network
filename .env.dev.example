# Firebase Cloud credentials for development environment
# Copy this file to .env.dev and fill in the values from your Firebase project settings.
# See docs/custom-domain-setup.md for detailed instructions.

# Required Firebase configuration (obtain from Firebase Console → Project Settings)
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="dev.peercoachingnetwork.com"
VITE_FIREBASE_PROJECT_ID="peer-coaching-network-dev"
VITE_FIREBASE_STORAGE_BUCKET="peer-coaching-network-dev.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
# VITE_FIREBASE_MEASUREMENT_ID="your-measurement-id"
VITE_FIRESTORE_DATABASE_ID=pcn-dev

# Logger configuration (debug, info, warn, error)
VITE_LOG_LEVEL="debug"
