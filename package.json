{
  "name": "peer-coaching-network",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "local": "vite --mode emulator",
    "build": "tsc -b && vite build --mode development",
    "build:dev": "tsc -b && vite build --mode development",
    "build:prod": "tsc -b && vite build --mode production",
    "lint": "tsc -b && eslint .",
    "preview": "vite preview",
    "test": "vitest run --project=unit",
    "coverage": "vitest run --project=unit --coverage",
    "seed": "node scripts/seed-emulator.cjs",
    "test:integration": "vitest run --project=integration",
    "test:perf": "TEST_USER_COUNT=100 vitest run --project=integration --reporter=verbose",
    "prepare": "git config core.hooksPath .githooks"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "dependencies": {
    "firebase": "^12.15.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.3.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-admin": "^14.1.0",
    "firebase-tools": "^15.23.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --max-warnings=0"
  }
}
