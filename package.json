{
  "name": "peer-coaching-network",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/shared",
    "functions",
    "web",
    "landing"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace=@pcn/shared",
    "pack:shared": "npm pack --workspace @pcn/shared --pack-destination ./functions",
    "build:functions": "npm run build --workspace=functions",
    "build:web": "npm run build --workspace=web",
    "build:landing": "npm run build --workspace=landing",
    "build:all": "npm run build:shared && npm run build:functions && npm run build:landing && npm run build:web",
    "dev": "npm run dev --workspace=web",
    "dev:landing": "npm run dev --workspace=landing",
    "tsc": "tsc -b",
    "eslint": "eslint .",
    "vitest": "vitest run --root web",
    "emulator:seed": "node scripts/seed-emulator.cjs"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^15.23.0",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": "npm run eslint -- --max-warnings=0"
  }
}
