VITE_FIREBASE_PROJECT_ID=peer-coaching-network-dev
VITE_USE_FIREBASE_EMULATOR=true

# Local or Dev environment configuration overrides
# If you want to connect to the cloud Firebase Dev environment instead of the emulators,
# set VITE_USE_FIREBASE_EMULATOR=false and uncomment the credentials below:
# VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
# VITE_FIREBASE_AUTH_DOMAIN=peer-coaching-network-dev.firebaseapp.com
# VITE_FIREBASE_STORAGE_BUCKET=peer-coaching-network-dev.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
# VITE_FIREBASE_APP_ID=YOUR_APP_ID

# Enable or disable Google Calendar integrations (creating/deleting events, checking freebusy).
# Defaults to true. Set to false for mocked local environment profiles.
VITE_ENABLE_GOOGLE_INTEGRATION=false

# Logger configuration (debug, info, warn, error)
VITE_LOG_LEVEL=debug
